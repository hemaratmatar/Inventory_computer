rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    match /product-list/{document} {
      allow read, create, update, delete: if signedIn();
    }

    match /per-list/{document} {
      allow read, create, update, delete: if signedIn();
    }

    match /room-list/{document} {
      allow read, create, update, delete: if signedIn();
    }
  }
}
